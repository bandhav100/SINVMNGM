# =============================================================================
# Smart Inventory Management System - Environment Configuration Example
# Copy this file to .env and adjust values for local development
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=smart_inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Spring Boot Backend ---
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_inventory_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# --- Security / JWT ---
JWT_SECRET=replace_with_a_secure_base64_or_random_secret_string_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# --- Frontend (Vite) ---
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8081/api/v1
